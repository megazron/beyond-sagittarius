{
  "appId": "com.megazron.beyondsagittarius",
  "appName": "Beyond Sagittarius",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#05060a",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "hidden": true
    }
  }
}
